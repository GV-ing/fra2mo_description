<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lidar_macro" >

  <!--<xacro:include filename="$(find fra2mo_description)/urdf/utility_macro.xacro" />-->

  <xacro:macro name="lidar_sensor" params="parent">

    <link name="laser_frame">
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.1" />
        <xacro:cylinder_inertia m="0.1" r="0.037" h="0.04" />
      </inertial>
      <visual>
        <origin rpy="0 0 ${-M_PI_2}" xyz="0.0 0.0 -0.031" />
        <geometry>
          <mesh filename="file://$(find fra2mo_description)/meshes/lidar.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="White" />
      </visual>
      <collision>
        <origin xyz="0.0 0.0 -0.031" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.04" radius="0.037" />
        </geometry>
      </collision>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="${parent}" />
      <child link="laser_frame" />
      <origin rpy="0 0 0" xyz="0.0 0.0 0.031" />
    </joint>

    
  
  </xacro:macro>
</robot>

