<?xml version="1.0"?>
<robot name="d435_gazebo_macro" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
  
  <xacro:macro name="d435_gazebo_sensor" params="parent">
    <xacro:sensor_d435 parent="${parent}" use_nominal_extrinsics="true" add_plug="false" use_mesh="true">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:sensor_d435>
    

    <!--The following code adds a Gazebo plugin to the camera sensor,
    which allows it to publish depth images in the Gazebo simulation environment.-->
    <gazebo reference="${parent}">
      <sensor type="rgbd_camera" name="depth_camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        
        <!--Topic name of camera-->
        <topic>depth_camera</topic>

        <!--Frame ID of the camera-->
        <gz_frame_id>d435_link</gz_frame_id><camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>30</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>